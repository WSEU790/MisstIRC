{
  "name": "misstirc",
  "version": "0.10.0",
  "description": "MisstIRC — a professional Windows IRC client",
  "main": "./out/main/index.js",
  "author": "MisstIRC",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-builder install-app-deps && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm rebuild better-sqlite3 && vitest run",
    "test:watch": "vitest",
    "rebuild:electron": "electron-builder install-app-deps",
    "postinstall": "npm rebuild better-sqlite3",
    "pack:dir": "npm run build && electron-builder --linux --x64 --dir",
    "pack:win:dir": "npm run build && electron-builder --win --x64 --dir -c.forceCodeSigning=false",
    "pack:win": "npm run build && electron-builder --win --x64 -c.forceCodeSigning=false"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
