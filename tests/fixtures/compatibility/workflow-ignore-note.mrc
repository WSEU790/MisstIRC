; Original MisstIRC fixture — documents app-level /ignore (not NNS prot modules)
; Protections from NNScript packs are unsupported; use client /ignore commands.
alias ignorehelp {
  echo -a Use slash ignore with a mask
  echo -a Use slash ignore -list and -r to manage session rules
  echo -a Channel-scoped filters live in network ignoreRules
}
